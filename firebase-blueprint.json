{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "isVerified": { "type": "boolean" },
        "verificationStatus": { "type": "string", "enum": ["verified", "unverified", "pending"] },
        "emergencyContact": { "type": "string", "maxLength": 100 },
        "emergencyPhone": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "email"]
    },
    "Ride": {
      "title": "Ride",
      "description": "Ride request or active trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string", "enum": ["moto", "car_comfort", "car_vip", "delivery"] },
        "pickupAddress": { "type": "string", "maxLength": 250 },
        "dropoffAddress": { "type": "string", "maxLength": 250 },
        "pickupCoords": { "type": "array" },
        "dropoffCoords": { "type": "array" },
        "priceUsd": { "type": "number" },
        "priceVes": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["searching", "accepted", "arrived", "in_trip", "completed", "cancelled"] },
        "driver": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "category", "pickupAddress", "dropoffAddress", "priceUsd", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet transaction for user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["recharge", "payment", "refund"] },
        "amountUsd": { "type": "string" },
        "amountVes": { "type": "string" },
        "method": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "reference": { "type": "string", "maxLength": 100 },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amountUsd", "method", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/rides/{rideId}": {
      "schema": { "$ref": "#/entities/Ride" },
      "description": "Ride requests collection"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Subcollection of user transactions"
    }
  }
}
